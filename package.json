{
  "name": "ghcp-maestro-workspace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Dev/CI workspace for the ghcp-maestro plugin. The runtime itself is zero-deps; tooling here (lint/test) is dev-only.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0"
  }
}
