# Node / npm — runtime is zero-deps; dev tooling (eslint) lives under devDependencies.
# node_modules stays ignored, but the lockfile is committed for reproducible CI.
node_modules/
yarn.lock
pnpm-lock.yaml
npm-debug.log*
yarn-error.log*

# Scratch dirs used during SDK inspection
_tmp/
.tmp/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Plugin runtime state (lives outside the repo by default, but ignore if present)
plugin-data/
runs/

# Build artefacts (none today, reserved for future M6/M7 work)
dist/
build/
