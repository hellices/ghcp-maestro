* text=auto eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf

# Keep development-only files out of release archives (GitHub release source
# tarballs and `git archive` honor export-ignore). The installable plugin only
# needs plugin.json + extensions/ + .github/plugin/marketplace.json +
# README/LICENSE/CHANGELOG; everything below is dev tooling, tests, CI, and
# design docs.
/AGENTS.md export-ignore
/docs/PLAN.md export-ignore
/docs/REQUIREMENTS.md export-ignore
/docs/RELEASING.md export-ignore
/docs/specs/ export-ignore
/docs/superpowers/ export-ignore
/tests/ export-ignore
/eslint.config.mjs export-ignore
/package-lock.json export-ignore
/scripts/ export-ignore
/vscode-extension/ export-ignore
/.github/workflows/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
